import Order from "../models/OrderModel.js";
import Product from "../models/productModel.js";

// สร้างประวัติการขายใหม่
export const createOrder = async (req, res) => {
    try {
        const {
            storeId,
            userId,
            items,
            subTotal,
            tax,
            total,
            paymentMethod,
            paidAmount,
            changeAmount
        } = req.body;

        const order = await Order.create({
            storeId,
            userId,
            items,
            subTotal,
            tax,
            total,
            paymentMethod,
            paidAmount,
            changeAmount,
        });

        for (const item of items) {
            const product = await Product.findById(item.productId);
            if (!product) continue;

            if (product.stockQty < item.qty && product.type !== "serialized") {
                return res.status(400).json({
                    error: `${product.name} สต็อกไม่พอ`,
                });
            }

            if (product.type === "serialized") {
                let soldCount = 0;
                product.serialList = product.serialList.map((s) => {
                    if (s.status === "available" && soldCount < item.qty) {
                        soldCount++;
                        return { ...s, status: "sold" };
                    }
                    return s;
                });
                // ✅ อัปเดต stockQty ให้ตรงกับ serial ที่เหลือ
                product.stockQty = product.serialList.filter(
                    (s) => s.status === "available"
                ).length;
            } else {
                product.stockQty = Math.max((product.stockQty || 0) - item.qty, 0);
            }

            await product.save();
        }

        res.status(201).json({
            message: "✅ Order created successfully and stock updated.",
            order,
        });
    } catch (err) {
        console.error("❌ Error creating order:", err);
        res.status(500).json({ error: "เกิดข้อผิดพลาดในการบันทึกคำสั่งซื้อ" });
    }
};


// ดึงประวัติการขายของร้าน
export const getOrdersByStore = async (req, res) => {
    try {
        const { storeId } = req.params;
        const orders = await Order.find({ storeId }).sort({ createdAt: -1 });
        res.status(200).json({ success: true, orders });
    } catch (err) {
        console.error("Error get orders:", err);
        res.status(500).json({ success: false, message: "เกิดข้อผิดพลาดในการดึงข้อมูล" });
    }
};
